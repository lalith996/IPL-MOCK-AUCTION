{
  "title": "Agent Fairness",
  "uid": "ipl-agent-fairness",
  "tags": ["ipl", "agents"],
  "timezone": "UTC",
  "refresh": "15s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Player Wins by Team",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "ipl_agent_wins_total",
        "legendFormat": "{{ agent_id }}"
      }]
    },
    {
      "id": 2,
      "title": "Total Spend by Team (Lakhs)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "ipl_agent_spend_lakhs_total",
        "legendFormat": "{{ agent_id }}"
      }]
    },
    {
      "id": 3,
      "title": "Isolation Probe Results (0 = PASS = expected)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "ipl_isolation_leak_total",
        "legendFormat": "Total leaks"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Agent Timeout Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum by(agent_id) (rate(ipl_agent_timeout_total[5m]))",
        "legendFormat": "{{ agent_id }}"
      }]
    },
    {
      "id": 5,
      "title": "Budget Remaining by Team (Lakhs)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "ipl_agent_budget_remaining_lakhs",
        "legendFormat": "{{ agent_id }}"
      }]
    },
    {
      "id": 6,
      "title": "Decision Latency p95 by Agent (SLO: 4s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "histogram_quantile(0.95, sum by(agent_id, le) (rate(ipl_agent_decision_duration_seconds_bucket[2m])))",
        "legendFormat": "{{ agent_id }}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 4 }
            ]
          }
        }
      }
    }
  ]
}
