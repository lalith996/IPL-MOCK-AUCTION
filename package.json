{
  "name": "ipl-2026-auction",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && ruff check services/ packages/",
    "typecheck": "pnpm -r typecheck && mypy services/ --ignore-missing-imports",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" && ruff format services/ packages/ && black services/ packages/",
    "schemas": "pnpm --filter @ipl/schemas generate"
  },
  "devDependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.0.10",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "jose": "^5.10.0",
    "next": "16.0.10",
    "postgres": "^3.4.9",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "2.1.9",
    "web-vitals": "^4.2.4",
    "ws": "^8.20.0",
    "zustand": "^5.0.12"
  }
}
