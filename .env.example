# ── IPL 2026 Auction — Environment Variables ──────────────────────────────────
# Copy to .env and fill in real values before running locally.
# Never commit .env to version control.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ipl_auction

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Service ports ──────────────────────────────────────────────────────────────
# Web spectator UI (Next.js)           → :3000  (default Next.js port)
# Admin console   (Next.js)            → :3001
# LLM Gateway     (Fastify)            → :3002
# Broadcaster     (WebSocket + HTTP)   → :3003
# Auction Manager (Fastify)            → :3004
# Agent Orchestrator (FastAPI/uvicorn) → :8001
# SAG             (FastAPI/uvicorn)    → :8002

# ── Inter-service URLs ─────────────────────────────────────────────────────────
LLM_GATEWAY_URL=http://localhost:3002
AUCTION_MANAGER_URL=http://localhost:3004
ORCHESTRATOR_URL=http://localhost:8001
SAG_URL=http://localhost:8002

# ── Next.js public environment vars (browser-visible) ─────────────────────────
# These must be prefixed NEXT_PUBLIC_ to be available in the browser bundle.
NEXT_PUBLIC_BROADCASTER_URL=ws://localhost:3003
NEXT_PUBLIC_AUCTION_MANAGER_URL=http://localhost:3004

# ── Authentication ─────────────────────────────────────────────────────────────
# JWT secret for operator tokens — must be ≥ 32 chars in production
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_32_CHARS_MINIMUM
# Password checked by POST /api/auth/operator in the admin console
OPERATOR_PASSWORD=changeme

# ── LLM Gateway ────────────────────────────────────────────────────────────────
# OpenRouter API key — sign up at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-CHANGE_ME
# Base URL for OpenRouter (leave as default unless using a custom proxy)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-auction LLM spend cap in USD cents (500 = $5.00)
LLM_BUDGET_CENTS_PER_AUCTION=500
# Rate limit for LLM calls (requests per second per model)
LLM_RATE_LIMIT_RPS=5

# ── Object store (MinIO / S3-compatible) ───────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ipl-headshots
# For production S3:
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── OpenTelemetry ──────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Override per service (e.g. auction-manager, llm-gateway, broadcaster)
OTEL_SERVICE_NAME=ipl-auction
OTEL_SERVICE_VERSION=0.1.0

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# NODE_ENV controls production vs development behaviour
NODE_ENV=development

# ── Auction Manager specific ───────────────────────────────────────────────────
# Stable identifier for this process instance (used for leader election).
# Leave blank to auto-generate a UUID at startup.
INSTANCE_ID=

# ── SAG service ────────────────────────────────────────────────────────────────
SAG_RATE_LIMIT_RPS=10
# External connector — set when operator chooses injury feed or social buzz API
# INJURY_FEED_URL=https://...
# SOCIAL_BUZZ_API_KEY=...

# ── Admin console ──────────────────────────────────────────────────────────────
# Port for the admin Next.js app (separate from web at :3000)
PORT=3001   # used by apps/admin dev server
